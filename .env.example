# =====================================================================
# Mealwise 环境变量模板：复制为 .env 后按需填写
#   cp .env.example .env
# 所有变量都有默认值，.env 不填也能起（AI 会自动降级为本地规则）
# =====================================================================

# ---- 数据库（compose 内部使用）----
MYSQL_ROOT_PASSWORD=root123456
DB_NAME=mealwise
DB_USER=mealwise
DB_PASSWORD=mealwise

# ---- 鉴权 ----
# 生产必须换成 >=32 字节的随机串，例如：openssl rand -base64 48
JWT_SECRET=mealwise-docker-demo-secret-key-please-change-0123456789

# ---- AI（DeepSeek / 任意 OpenAI 兼容服务）----
# 留空 = 不调用模型：解析走正则、解释走规则原文、问答走检索、Agent 返回 disabled
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=60000
