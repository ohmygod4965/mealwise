/* 全局样式与设计变量（与 H5 端保持同一套视觉） */
page {
  background: #f5f7f6;
  color: #1f2d27;
  font-size: 28rpx;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.page {
  padding: 24rpx 24rpx 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 45, 39, 0.06);
}

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.muted {
  color: #7b8a83;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.btn-primary {
  background: #3fb37d;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
  border: none;
}

.btn-primary[disabled] {
  background: #a9d6c2;
  color: #fff;
}

.btn-ghost {
  background: #eaf5ef;
  color: #237b53;
  border-radius: 16rpx;
  font-size: 26rpx;
  padding: 16rpx 28rpx;
  border: none;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #eef3f0;
  color: #5c6f66;
}

.tag--under { background: #fff3e6; color: #b26a12; }
.tag--ok { background: #e8f6ef; color: #237b53; }
.tag--over { background: #fdeceb; color: #b3372f; }

.divider {
  height: 1rpx;
  background: #eef1ef;
  margin: 20rpx 0;
}

.bar {
  height: 12rpx;
  background: #eef1ef;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 12rpx 0 8rpx;
}

.bar__fill {
  height: 100%;
  border-radius: 999rpx;
  background: #3fb37d;
}

.bar__fill--under { background: #f0a04b; }
.bar__fill--over { background: #d9534f; }

.empty {
  text-align: center;
  padding: 48rpx 0;
  color: #8a9a92;
  font-size: 26rpx;
}
