.types {
  display: flex;
  background: #fff;
  border-radius: 18rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.type {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #6b7a72;
  border-radius: 12rpx;
}

.type.is-active {
  background: #3fb37d;
  color: #fff;
  font-weight: 600;
}

.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search__input {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
}

.search__btn {
  background: #3fb37d;
  color: #fff;
  border-radius: 16rpx;
  padding: 22rpx 30rpx;
  font-size: 28rpx;
}

.result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f3f1;
}

.result:last-child {
  border-bottom: none;
}

.result__name {
  font-size: 28rpx;
  font-weight: 600;
}

.result__add {
  background: #eaf5ef;
  color: #237b53;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
}

.line {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f3f1;
}

.line:last-child {
  border-bottom: none;
}

.line__main {
  flex: 1;
  min-width: 0;
}

.line__name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.line__qty {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-right: 16rpx;
}

.qty {
  width: 110rpx;
  background: #f4f7f5;
  border-radius: 12rpx;
  padding: 10rpx;
  text-align: center;
  font-size: 26rpx;
}

.line__del {
  color: #b3372f;
  font-size: 24rpx;
}

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 45, 39, 0.08);
}

.footer__cal {
  font-size: 40rpx;
  font-weight: 700;
  color: #237b53;
}

.footer__btn {
  width: 320rpx;
  padding: 18rpx 0;
  font-size: 26rpx;
}
