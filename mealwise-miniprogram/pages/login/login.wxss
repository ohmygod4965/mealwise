.login {
  padding: 80rpx 40rpx;
}

.login__brand {
  text-align: center;
  margin-bottom: 48rpx;
}

.login__logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 20rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #3fb37d, #237b53);
  color: #fff;
  font-size: 60rpx;
  font-weight: 700;
}

.login__name {
  font-size: 40rpx;
  font-weight: 700;
}

.login__tagline {
  color: #7b8a83;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.login__card {
  padding: 32rpx;
}

.login__tabs {
  display: flex;
  background: #f1f4f2;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 32rpx;
}

.login__tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6b7a72;
  border-radius: 12rpx;
}

.login__tab.is-active {
  background: #fff;
  color: #237b53;
  font-weight: 600;
}

.field {
  margin-bottom: 24rpx;
}

.field__label {
  font-size: 24rpx;
  color: #6b7a72;
  margin-bottom: 10rpx;
}

.field__input {
  background: #f6f8f7;
  border-radius: 14rpx;
  padding: 22rpx 20rpx;
  font-size: 28rpx;
}

.login__hint {
  text-align: center;
  color: #9aa8a1;
  font-size: 22rpx;
  margin-top: 24rpx;
}
