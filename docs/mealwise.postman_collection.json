            },
            "description": "返回明细与合计（热量/蛋白/脂肪/碳水，1 位小数）。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"业务码 200\", () => pm.expect(pm.response.json().code).to.eql(200));",
                  "pm.test(\"有合计\", () => pm.expect(pm.response.json().data.total.calories).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "修改克数",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/meals/{{mealId}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meals",
                "{{mealId}}",
                "items",
                "{{itemId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityG\": 150\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"业务码 200\", () => pm.expect(pm.response.json().code).to.eql(200));",
                  "pm.test(\"克数已更新\", () => pm.expect(pm.response.json().data.quantityG).to.eql(150));"
                ]
              }
            }
          ]
        },
        {
          "name": "替换建议 higher",
          "request": {
            "method": "GET",
            "header": [
