                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/meals/{{mealId}}/replacements?strategy=higher",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meals",
                "{{mealId}}",
                "replacements?strategy=higher"
              ]
            },
            "description": "无候选时 suggestions 为空 + message 有值，仍是 200。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"业务码 200\", () => pm.expect(pm.response.json().code).to.eql(200));",
                  "const data = pm.response.json().data;",
                  "pm.test(\"每组最多 3 条\", () => data.items.every(i => i.suggestions.length <= 3));",
                  "pm.test(\"建议均为同类别\", () => data.items.every(i => i.suggestions.every(s => s.category === i.originalFood.category)));"
                ]
              }
